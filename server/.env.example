# -------------------------------------------------------------
# Pothole Detection & Civic Reporting System - Environment Variables
# -------------------------------------------------------------

# Backend Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String (Local instance or MongoDB Atlas)
# Default: mongodb://127.0.0.1:27017/potholedb
# Note: If MongoDB is unavailable, the backend automatically uses its local persistent JSON fallback store.
MONGODB_URI=mongodb://127.0.0.1:27017/potholedb

# Standalone Python AI Microservice URL (FastAPI / YOLOv8)
# Default: http://127.0.0.1:8000/detect
# Note: If this microservice is not running, the backend seamlessly uses its integrated computer-vision analyzer.
AI_SERVICE_URL=http://127.0.0.1:8000/detect
